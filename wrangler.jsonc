{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamline",
  "compatibility_date": "2026-06-08",
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
