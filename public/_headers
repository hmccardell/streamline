# Photos carry a stable name and are only ever replaced by renaming (e.g.
# automation-blue -> automation-blue2, founder -> founder2), so repeat visits
# can treat them as immutable for a year.
/automation-*
  Cache-Control: public, max-age=31536000, immutable
/founder*
  Cache-Control: public, max-age=31536000, immutable
/owner-*
  Cache-Control: public, max-age=31536000, immutable
/teacher-teal*
  Cache-Control: public, max-age=31536000, immutable
